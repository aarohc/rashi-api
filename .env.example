# rashi-api — optional env for local dev (copy to .env if desired)
PORT=3000

# Deploy (./deploy.sh): set RASHI_API_WEBAPP_NAME (or legacy AZURE_FUNCTION_APP_NAME).
# Optional: RASHI_API_RESOURCE_GROUP or legacy AZURE_RESOURCE_GROUP (default cosmicconnect_group).
# RASHI_API_AZURE_TYPE=webapp|functionapp — default webapp when using RASHI_API_* app name; functionapp when only AZURE_FUNCTION_APP_NAME is set.
# Syncs this file to Azure application settings.

# Optional: same MongoDB/Cosmos API as cosmicconnect — collection rashiGenericDataOverrides
# Documents: { _id: string, payload: object }. _id examples:
#   generic:planet:en   — replaces data/en/planet.json shape (planetInHouse root keys)
#   generic:house:es
#   generic:dasha-generic:hi
#   generic:dasha-maha:gu
#   generic:pratyadasha-generic:en
#   yoga-descriptions  — replaces data/yoga-descriptions.json
# Rashi refreshes cache on startup (Express) or every ~5 min on first request (Azure function path).
# Seed from repo JSON (same DB as cosmicconnect): from api/cosmicconnect-api run `npm run seed:content-to-mongo`
RASHI_CONTENT_MONGODB_URI="mongodb+srv://aarohc:Qazwsxedc123@cosmicconnect-db.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
